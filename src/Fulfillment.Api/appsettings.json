{
  "ConnectionStrings": {
    "Fulfillment": "Data Source=fulfillment.db"
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedSampleData": false
  },
  "LowStockSentinel": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*"
}
